if(NOT DEFINED INPUT_FILE)
    message(FATAL_ERROR "INPUT_FILE is required.")
endif()

if(NOT EXISTS "${INPUT_FILE}")
    message(FATAL_ERROR "File does not exist: ${INPUT_FILE}")
endif()

if(APPLE)
    set(_open_command open)
elseif(WIN32)
    set(_open_command cmd)
    set(_open_args /c start "" "${INPUT_FILE}")
else()
    find_program(_open_command xdg-open)
    if(NOT _open_command)
        message(FATAL_ERROR "Could not find a system opener. Open this file manually: ${INPUT_FILE}")
    endif()
endif()

if(WIN32)
    execute_process(COMMAND ${_open_command} ${_open_args} RESULT_VARIABLE _open_result)
else()
    execute_process(COMMAND ${_open_command} "${INPUT_FILE}" RESULT_VARIABLE _open_result)
endif()

if(NOT _open_result EQUAL 0)
    message(FATAL_ERROR "Failed to open: ${INPUT_FILE}")
endif()
