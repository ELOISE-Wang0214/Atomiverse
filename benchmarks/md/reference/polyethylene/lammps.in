# benchmarks/md/reference/polyethylene/lammps.in
#
# LAMMPS reference input mirroring the 5-stage MSU amorphous-polyethylene
# uniaxial-tension protocol that benchmarks/md/polyethylene_tension.cpp
# drives in Atomiverse. Both engines start from the same initial geometry
# (msu_pe.data, generated separately -- see README.md) and apply the same
# Dreiding-style united-atom force field.
#
# Stages:
#   1. NVT @ 500 K, dt = 1.0 fs, 10 000 steps     -- initial randomisation
#   2. NPT @ 500 K, dt = 0.5 fs, 50 000 steps     -- density relaxation
#   3. NVT cool 500 -> 100 K (linear T ramp), 50 000 steps
#   4. NPT @ 100 K, dt = 0.5 fs, 50 000 steps     -- glassy equilibration
#   5. Tension along x at e_dot = 1e-6/fs to e ~ 1.0, 200 000 steps
#
# Output:
#   thermo_reference.csv        step, T, P, E_pot, E_kin, Pxx, Pyy, Pzz
#   stress_strain_reference.csv strain, sigma_xx
#
# Run:
#   lmp -in lammps.in -log log.lammps
# then post-process log.lammps via tools/lammps_log_to_csv.py (TBD).
#
# Hardware/version annotations: see README.md.

# ── Setup ───────────────────────────────────────────────────────────
units           real
atom_style      molecular
boundary        p p p

read_data       msu_pe.data

# ── Force field (Dreiding-style UA) ─────────────────────────────────
bond_style      harmonic
bond_coeff      1   350.0   1.529        # k [kcal/mol/A^2], r0 [A]

angle_style     harmonic
angle_coeff     1    58.35  112.7        # k [kcal/mol/rad^2], theta0 [deg]

dihedral_style  multi/harmonic
dihedral_coeff  1   2.0058 -2.5128 0.2710 6.2900 0.0   # OPLS-style

pair_style      lj/cut 10.5
pair_coeff      1 1   0.112  4.01        # eps [kcal/mol], sigma [A]

# Dreiding 1-4 exclusion: zero contribution from 1-2, 1-3, 1-4 pairs.
special_bonds   lj 0.0 0.0 0.0

# ── Neighbor list ───────────────────────────────────────────────────
neighbor        2.0 bin
neigh_modify    delay 5 every 1 check yes

# ── Output ──────────────────────────────────────────────────────────
thermo_style    custom step temp press pe ke pxx pyy pzz lx ly lz
thermo          100
thermo_modify   format line "%-d %.6g %.6g %.6g %.6g %.6g %.6g %.6g %.6g %.6g %.6g"

# ── Stage 1 — NVT @ 500 K, dt = 1.0 fs ──────────────────────────────
velocity        all create 500.0 12345 mom yes rot yes dist gaussian
fix             stage1 all nvt temp 500.0 500.0 100.0
timestep        1.0
run             10000
unfix           stage1

# ── Stage 2 — NPT @ 500 K, P = 0 bar, dt = 0.5 fs ───────────────────
fix             stage2 all npt temp 500.0 500.0 100.0 iso 0.0 0.0 1000.0
timestep        0.5
run             50000
unfix           stage2

# ── Stage 3 — NVT cool 500 -> 100 K (linear ramp) ───────────────────
fix             stage3 all nvt temp 500.0 100.0 100.0
run             50000
unfix           stage3

# ── Stage 4 — NPT @ 100 K, P = 0 bar ────────────────────────────────
fix             stage4 all npt temp 100.0 100.0 100.0 iso 0.0 0.0 1000.0
run             50000
unfix           stage4

# ── Stage 5 — Uniaxial tension along x, e_dot = 1e-6/fs ────────────
# erate = e_dot in 1/timestep units. dt = 0.5 fs and we want 1e-6/fs,
# so erate = 5e-7 per timestep.
variable        erate equal 5.0e-7
fix             stage5_def all deform 1 x erate ${erate} units box remap x
fix             stage5_th  all nvt temp 100.0 100.0 100.0
fix             stage5_st  all ave/time 1 100 100 c_thermo_press[1] file stress_strain_reference.csv

# Custom CSV writers
fix             record_thermo all print 100 "$(step) $(temp) $(press) $(pe) $(ke) $(pxx) $(pyy) $(pzz)" &
                file thermo_reference.csv screen no &
                title "step T P E_pot E_kin Pxx Pyy Pzz"

run             200000

unfix           stage5_def
unfix           stage5_th
unfix           stage5_st

# Done.
print           "LAMMPS PE-tension reference run complete."
