# Bonded-energy reference for spec c20h42-energy-xcheck.
#
# Single-point (run 0) bonded-energy decomposition of the perturbed
# all-trans C20H42 united-atom chain in c20h42_chain.data, using the
# MSU Dreiding-UA constants from lammps_msu_paper.in. Bonded terms only
# (pair_style none) — this deck exists to produce the LAMMPS reference
# ebond / eangle / edihed that the Atomiverse cross-check test embeds.
#
# Regenerate:  lmp_serial -in in.c20h42_energy
# (run from this directory so the relative read_data path resolves.)

units           real
atom_style      molecular
boundary        f f f

read_data       c20h42_chain.data

bond_style      harmonic
bond_coeff      1 350.0 1.53

angle_style     harmonic
angle_coeff     1 60.0 109.5

dihedral_style  multi/harmonic
dihedral_coeff  1 1.73 -4.49 0.776 6.99 0.0

pair_style      none

thermo_style    custom step ebond eangle edihed
thermo_modify   format float %.14g
thermo          1
run             0
