# United-atom PE melt — matches polyethylene_tension --pe-melt-grid / stage:1.
# Scalable via read_data(unit cell) + replicate (NO giant data file, aligned
# chains = no clashes/rotation). MSU Tschopp 2010 Dreiding FF.
#   lmp -k on g <ng> -sf kk -pk kokkos gpu/aware on -in in.pe_kk \
#       -v nx <nx> -v ny <ny> -v nz <nz> -v steps <S>
# Atom count = nx*ny*nz*18.  Base cell from gen_pe_chain_mol.py (pe_base.data).
variable nx    index 16
variable ny    index 16
variable nz    index 16
variable steps index 500

units           real
atom_style      molecular
boundary        p p p

read_data       pe_base.data &
                extra/special/per/atom 30
replicate       ${nx} ${ny} ${nz}

bond_style      harmonic
bond_coeff      1 350 1.53
angle_style     harmonic
angle_coeff     1 60 109.5
dihedral_style  multi/harmonic
dihedral_coeff  1 1.73 -4.49 0.776 6.99 0.0
pair_style      lj/cut 10.5
pair_coeff      1 1 0.112 4.01 10.5
special_bonds   lj 0.0 0.0 0.0

neighbor        1.0 bin
neigh_modify    every 10 delay 0 check no one 10000

velocity        all create 500.0 12345 loop geom
fix             1 all nve/limit 0.05
fix             2 all langevin 500.0 500.0 10.0 904297
timestep        1.0

thermo          100
thermo_style    custom step temp pe ke etotal press density

run             20 post no
reset_timestep  0
run             ${steps} post no
