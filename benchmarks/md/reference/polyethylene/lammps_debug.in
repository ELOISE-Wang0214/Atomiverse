# lammps_debug.in — minimal NVE/limit→NPT debug deck on the MSU 10k-atom PE
# system, the LAMMPS counterpart of benchmarks/md/debug_nve_npt.cpp.
#
# Purpose: a SHORT, fully deterministic run that can be diffed column-by-column
# against the Atomiverse `debug_nve_npt` CSV to pin a force/energy bug without
# the ~24h, MPI, thermostatted full protocol (lammps.in / lammps_msu_paper.in).
#
# Determinism — to match the AV driver exactly, this deck:
#   * zeroes all velocities (`velocity all set 0 0 0`) — no `create`, no RNG;
#   * relaxes with bare `fix nve/limit 0.1` (NO langevin) so stage 1 is a pure
#     function of the forces, matching AV's NVELimit-only relaxation;
#   * emits thermo EVERY step with the per-term energy decomposition.
#
# Force field is byte-for-byte the Dreiding-UA deck from lammps_msu_paper.in.
# Units `real` ⇒ energies in kcal/mol; compare against the AV CSV's *_kcal
# columns (AV is internally eV; it emits both eV and kcal/mol).
#
# Run:   lmp -in lammps_debug.in -log log.debug
#        (cd into this directory first so `read_data msu_pe.data` resolves)
#
# Step counts mirror the AV defaults (--nve 200 --npt 200); shorten freely.

units           real
boundary        p p p
atom_style      molecular
read_data       msu_pe.data

# ---- Dreiding-UA force field (verbatim from lammps_msu_paper.in) ----
neighbor        0.4 bin
neigh_modify    every 10 one 10000
bond_style      harmonic
bond_coeff      1 350 1.53
angle_style     harmonic
angle_coeff     1 60 109.5
dihedral_style  multi/harmonic
dihedral_coeff  1 1.73 -4.49 0.776 6.99 0.0
pair_style      lj/cut 10.5
pair_coeff      1 1 0.112 4.01 10.5
# special_bonds left at the LAMMPS default (lj 0 0 0): 1-2/1-3/1-4 fully
# excluded, matching AV's LJ.set_special_bonds(0,0,0).

# ---- per-step thermo with full energy decomposition ----
# Columns line up with debug_nve_npt's CSV: pe↔pe_kcal, evdwl↔e_pair,
# ebond↔e_bond, eangle↔e_angle, edihed↔e_dihedral, ke↔ke_kcal, temp↔temp_K,
# lx/ly/lz↔box_x/box_y/box_z.
thermo_style    custom step pe evdwl ebond eangle edihed ke temp lx ly lz
thermo          1
thermo_modify   norm no

# Deterministic start: zero velocities (single point at step 0, then dynamics
# is a pure function of the forces — matches the AV driver).
velocity        all set 0.0 0.0 0.0

# ---- Stage 1: relaxation (fix nve/limit 0.1, no thermostat) ----
fix             1 all nve/limit 0.1
timestep        1.0
run             200
unfix           1

# ---- Stage 2: NPT (fix npt temp 300 300 50, iso 0 0 500) ----
# tau_T = 100*dt = 50 fs, tau_P = 1000*dt = 500 fs (dt = 0.5) — mirrors the
# AV NoseHooverNPT::Config in debug_nve_npt.cpp.
fix             2 all npt temp 300.0 300.0 50.0 iso 0.0 0.0 500.0
timestep        0.5
run             200
unfix           2
