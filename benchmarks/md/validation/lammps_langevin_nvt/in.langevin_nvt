# LAMMPS NVT-Langevin parity reference for Atomiverse.
#
# 256 LJ "argon" atoms on an FCC lattice (lattice param a = 5.79 Å so atoms
# don't overlap), `fix langevin` thermostat at 300 K with damp = 100 fs.
# Units `metal` so the values map 1:1 onto Atomiverse (eV, Å, ps; we use
# dt = 0.001 ps = 1 fs to match Atomiverse's femtosecond timestep).
#
# After 100 000 steps the ensemble means are dumped via `fix ave/time` for
# the test in tests/cpu/md/test_lammps_langevin_parity.cpp to consume.

units           metal
atom_style      atomic
boundary        p p p

# 4×4×4 FCC unit cells × 4 atoms = 256 atoms.
lattice         fcc 5.79
region          box block 0 4 0 4 0 4
create_box      1 box
create_atoms    1 box
mass            1 39.948               # amu (argon)

# LJ: ε = 120 K · k_B = 0.010339 eV, σ = 3.405 Å, cutoff = 8.5 Å.
pair_style      lj/cut 8.5
pair_coeff      1 1 0.010339 3.405

# Initial velocities at the target temperature.
velocity        all create 300.0 12345 mom yes rot yes dist gaussian

# Langevin thermostat with damp = 100 fs = 0.1 ps in metal units.
fix             1 all nve
fix             2 all langevin 300.0 300.0 0.1 904297

timestep        0.001                  # ps -> 1 fs

# Skip the burn-in window from the running average.
thermo_style    custom step temp ke pe etotal press
thermo          1000

# Burn in (≈10 damping times to wash out the IC).
run             1000

# Compute & average post-burn-in.
reset_timestep  0
compute         ctemp all temp
compute         cke   all ke
compute         cpe   all pe
fix             avgs all ave/time 1 99000 99000 c_ctemp c_cke c_cpe &
                file lammps_avgs.txt mode scalar

run             99000

print "All done"
