units           metal
atom_style      charge
boundary        p p p
read_data       DATAFILE
pair_style      coul/long 5.358
pair_coeff      * *
kspace_style    pppm 1.0e-5
kspace_modify   gewald 0.6532288167226578
kspace_modify   mesh 24 24 24
kspace_modify   order 6
velocity        all set 0.0 0.0 0.0 units box
compute         peratom all property/atom fx fy fz
compute         fsum all reduce sum c_peratom[1] c_peratom[2] c_peratom[3]
thermo_style    custom step pe pxx pyy pzz pxy pxz pyz vol lx
thermo          1
run             0 post no
print           "TAG E=$(pe) pxx=$(pxx) pyy=$(pyy) pzz=$(pzz) pxy=$(pxy) pxz=$(pxz) pyz=$(pyz) V=$(vol) lx=$(lx) fsumx=$(c_fsum[1]) fsumy=$(c_fsum[2]) fsumz=$(c_fsum[3])" file OUTFILE screen yes
write_dump      all custom FORCEFILE id type x y z fx fy fz modify sort id
