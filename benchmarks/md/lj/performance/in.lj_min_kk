# LJ minimization deck matching benchmarks bench_minimize.cu (AV CUDA
# minimizer). Reads the IDENTICAL jittered fcc configuration emitted by
# bench_minimize (its data_out argument) so both engines relax the same
# coordinates; pair_modify shift yes matches the cutoff-shifted cuda::LJ.
# Force-only stopping (etol = 0), min_modify norm max = per-atom max |F|,
# the same criterion as the AV ConvCheck ftol. Run with KOKKOS/CUDA:
#   lmp -k on g 1 -sf kk -pk kokkos gpu/aware on -in in.lj_min_kk \
#       -v data lj_min_N.data -v style cg -v ftol 1e-4 -v maxiter 5000
# NB this LAMMPS KOKKOS build requires /kk min styles: -sf kk maps
# cg -> cg/kk and fire -> fire/kk; sd has no /kk variant and errors.
variable        data    index lj_min.data
variable        style   index cg
variable        ftol    index 1e-4
variable        maxiter index 5000
variable        maxeval equal ${maxiter}*10

units           lj
atom_style      atomic
read_data       ${data}

pair_style      lj/cut 2.0
pair_coeff      1 1 1.0 1.0
pair_modify     shift yes

neighbor        0.6 bin
neigh_modify    every 1 delay 0 check yes

thermo          100
thermo_style    custom step pe fmax fnorm
thermo_modify   norm no

min_style       ${style}
min_modify      norm max
minimize        0.0 ${ftol} ${maxiter} ${maxeval}
